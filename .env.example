# ============================================
# RAILWAY DEPLOYMENT ENVIRONMENT VARIABLES
# Copy các biến này vào Railway Project Settings > Variables
# ============================================

# Server
PORT=5000
NODE_ENV=production

# Database (Railway PostgreSQL plugin sẽ tự động cung cấp DATABASE_URL)
# Nếu dùng Railway PostgreSQL: để trống DB_* và chỉ set DATABASE_URL
DATABASE_URL=postgresql://postgres:password@host:port/railway
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ketoan_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=true

# Security
JWT_SECRET=Thay_Doi_Chuoi_Nay_Thanh_Cai_Gi_Do_Rat_Dai_Va_Bao_Mat_123!

# Redis (Railway Redis plugin sẽ tự động cung cấp REDIS_URL)
REDIS_URL=redis://localhost:6379

# CORS - Danh sách origin frontend được phép (comma-separated)
FRONTEND_URL=https://ketoanonline.up.railway.app,https://banhang.up.railway.app

# Serve static frontend từ backend (set true nếu deploy chung)
SERVE_STATIC_FRONTEND=false

# Database seeding (true để auto-seed khi bảng users rỗng)
SEED_DATABASE=false

# Business Rules (optional - JSON config)
# BUSINESS_RULES_JSON={"pricing":{"defaultTaxRate":0.08,"taxRules":[...]}}