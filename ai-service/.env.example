# Python AI Service Environment Variables

# Service Configuration
PORT=8000
HOST=0.0.0.0

# Model Configuration
MODEL_DIR=./models
PYTHON_ENV=production

# AI Service Internal Authentication (Shared Secret)
# Must match the value in backend/.env
AI_INTERNAL_SECRET=your_ai_internal_secret_here

# Database (for training data)
DATABASE_URL=postgresql://user:pass@localhost:5432/ketoan

# Backend API URL (for fetching training data)
BACKEND_URL=https://dazzling-grace-production-03a5.up.railway.app

# Gemini (Google AI) - Free tier
# IMPORTANT: Set GEMINI_API_KEY in Railway environment variables, NOT in .env file
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Logging
LOG_LEVEL=INFO

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379