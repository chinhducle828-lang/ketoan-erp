# Public backend base URL (without /api)
# Local: http://localhost:5000
# Railway: https://your-backend-service.up.railway.app
VITE_API_BASE_URL=http://localhost:5000

# Optional base path if deployed under sub-path. Keep / for custom domain root.
VITE_BASE_URL=/

# Optional (default false): show manual role switcher in storefront header for local testing only.
VITE_ALLOW_ROLE_SWITCH=false
