# API Configuration
VITE_API_URL=http://localhost:5000/api

# WebSocket Configuration
VITE_WS_URL=http://localhost:5000

# Storefront URL
VITE_STOREFRONT_URL=http://localhost:3001

# ERP URL for redirects (optional, will use query param or referrer if not set)
# Used for "Back to ERP" functionality and admin session validation
VITE_ERP_URL=https://ketoanonline.up.railway.app

# VAPID Public Key for Web Push Notifications (generate with: node generate-vapid-keys.mjs)
# Get the public key from backend/.env VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=

# Application Environment
VITE_ENV=development

# Optional: Authentication (if using JWT)
# VITE_AUTH_TOKEN_KEY=token