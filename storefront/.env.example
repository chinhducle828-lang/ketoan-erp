# Production API URL - Backend ERP đang chạy trên Railway
VITE_API_BASE_URL=https://dazzling-grace-production-03a5.up.railway.app
VITE_BASE_URL=/
# ERP URL - Cùng domain với backend (dùng để chuyển hướng đăng nhập)
VITE_ERP_URL=https://dazzling-grace-production-03a5.up.railway.app
# Nếu ERP và storefront cùng dự án Railway, bạn có thể dùng hostname nội bộ để chuyển hướng nhanh hơn.
# Railway internal service name: banhang.railway.internal
VITE_STOREFRONT_URL=http://banhang.up.railway.internal
# Feature flag: Enable role switching UI (set to 'true' for development only)
VITE_ALLOW_ROLE_SWITCH=false