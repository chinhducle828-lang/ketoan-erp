# Production API URL - Backend Railway
VITE_API_BASE_URL=https://dazzling-grace-production-03a5.up.railway.app

# Frontend URL
VITE_BASE_URL=/

# Storefront URL
VITE_STOREFRONT_URL=https://banhang.up.railway.app

# WebSocket Configuration
VITE_WS_URL=https://dazzling-grace-production-03a5.up.railway.app

