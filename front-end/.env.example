# API Backend URL - Thay đổi theo môi trường
# Development: http://localhost:5000
# Production: https://ketoan-backend.railway.app (hoặc domain của bạn)
VITE_API_BASE_URL=http://localhost:5000

# Base URL của storefront khi deploy trên Railway hoặc custom domain
VITE_BASE_URL=/

# URL của storefront độc lập (dùng cho nút mở gian hàng từ màn hình đăng nhập ERP)
VITE_STOREFRONT_URL=https://your-storefront-domain.up.railway.app