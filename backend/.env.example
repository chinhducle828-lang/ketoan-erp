PORT=5000

# ============================================
# HYBRID DATABASE CONFIGURATION
# ============================================
# Production (Railway/Render): Use DATABASE_URL
# DATABASE_URL=postgresql://postgres:password@host:port/railway

# Local Development: Use individual variables below
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ketoan_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=Thay_Doi_Chuoi_Nay_Thanh_Cai_Gi_Do_Rat_Dai_Va_Bao_Mat_123!

# ============================================
# REDIS (Optional - for caching)
# ============================================
# Production: Railway will provide REDIS_URL automatically
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# DATABASE SEEDING
# ============================================
# Set to 'true' to auto-seed database with test data on startup
# WARNING: Only works if users table is empty
SEED_DATABASE=false

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated frontend origins allowed by CORS
# Production: https://ketoanonline.up.railway.app,https://banhang.up.railway.app
# Local: http://localhost:3000
FRONTEND_URL=https://ketoanonline.up.railway.app,https://banhang.up.railway.app

# ============================================
# CASSO OPEN BANKING (THANH TOÁN ONLINE)
# ============================================
# Authcode / API key from Casso (https://oauth.casso.vn)
CASSO_API_KEY=
# Public base URL of this backend (used to build webhook callback URL)
PUBLIC_APP_URL=https://your-backend.up.railway.app
# Optional override of Casso API base (default https://oauth.casso.vn/v2)
# CASSO_BASE_URL=https://oauth.casso.vn/v2
# Optional override of webhook path (default /api/casso/webhook)
# CASSO_WEBHOOK_PATH=/api/casso/webhook
