PORT=5000

# ============================================
# HYBRID DATABASE CONFIGURATION
# ============================================
# Production (Railway/Render): Use DATABASE_URL
# DATABASE_URL=postgresql://postgres:password@host:port/railway

# Local Development: Use individual variables below
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ketoan_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=Thay_Doi_Chuoi_Nay_Thanh_Cai_Gi_Do_Rat_Dai_Va_Bao_Mat_123!

# AI Service Internal Authentication (Shared Secret)
# Used for secure communication between Backend and AI Service
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_INTERNAL_SECRET=your_ai_internal_secret_here

# ============================================
# REDIS (Optional - for caching)
# ============================================
# Production: Railway will provide REDIS_URL automatically
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# DYNAMIC POSTING ENGINE (Phase 1)
# ============================================
# Bật/tắt Dynamic Posting Engine (thay thế hard-code account numbers)
# Khi bật, các entries sẽ được sinh từ bảng accounting_posting_rules
# Thay vì từ hard-code trong reaEventMapper.js
# USE_DYNAMIC_POSTING=true
# Mặc định: false (giữ nguyên behavior cũ)
USE_DYNAMIC_POSTING=false

# ============================================
# DATABASE SEEDING
# ============================================
# Set to 'true' to auto-seed database with test data on startup
# WARNING: Only works if users table is empty
SEED_DATABASE=false

# ============================================
# ROOT ADMIN CREDENTIALS (Auto-created on first run if DB is empty)
# ============================================
# Default root admin username (only used when users table is empty)
ADMIN_USERNAME=admin
# Default root admin password (CHANGE THIS in production!)
ADMIN_PASSWORD=Admin@123

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated frontend origins allowed by CORS
# Production: https://ketoanonline.up.railway.app,https://banhang.up.railway.app
# Local: http://localhost:3000
FRONTEND_URL=https://ketoanonline.up.railway.app,https://banhang.up.railway.app

# ============================================
# BACKEND URL CONFIGURATION
# ============================================
# Backend API URL for inter-service communication
BACKEND_URL=https://dazzling-grace-production-03a5.up.railway.app

# ============================================
# CASSO OPEN BANKING (THANH TOÁN ONLINE)
# ============================================
# Authcode / API key from Casso (https://oauth.casso.vn)
CASSO_API_KEY=
# Public base URL of this backend (used to build webhook callback URL)
PUBLIC_APP_URL=https://dazzling-grace-production-03a5.up.railway.app
# Optional override of Casso API base (default https://oauth.casso.vn/v2)
# CASSO_BASE_URL=https://oauth.casso.vn/v2
# Optional override of webhook path (default /api/casso/webhook)
# CASSO_WEBHOOK_PATH=/api/casso/webhook

# ============================================
# FIREBASE CLOUD MESSAGING (FCM) - MOBILE PUSH
# ============================================
# FCM Server Key từ Google Firebase Console
# Dùng để gửi push notification tới mobile app
FCM_SERVER_KEY=your_fcm_server_key_here

# ============================================
# WEB PUSH NOTIFICATIONS (VAPID)
# ============================================
# Tạo bằng: node generate-vapid-keys.mjs
# Frontend phải có VITE_VAPID_PUBLIC_KEY trùng khớp với VAPID_PUBLIC_KEY bên dưới
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@ketoan-erp.com

# ============================================
# AI CONFIGURATION - MULTI-KEY POOL & CLOUDFLARE PROXY
# ============================================

# ===== GOOGLE GEMINI API KEYS (Multiple for load balancing) =====
# Get free API keys at: https://aistudio.google.com/app/apikey
# Comma-separated list of API keys
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# ===== GROQ API KEYS (Multiple for load balancing) =====
# Get free API keys at: https://console.groq.com/keys
# Comma-separated list of API keys
# GROQ_KEYS=your_groq_api_key_1,your_groq_api_key_2

# ===== CLOUDFLARE WORKER PROXY (Avoid IP blocking) =====
# Set to true to route all AI API calls through Cloudflare Worker for IP masking
USE_CLOUDFLARE_PROXY=true
CLOUDFLARE_PROXY_URL=https://nvoice-ai-proxy.progefa.workers.dev/

# ===== AI API CONCURRENCY & RETRY SETTINGS =====
# Maximum number of concurrent AI API requests (load balancing)
MAX_CONCURRENT_REQUESTS=5

# AI API request timeout in milliseconds
AI_REQUEST_TIMEOUT=30000

# Maximum retry attempts for failed AI API calls
AI_MAX_RETRIES=3

# Delay between retries in milliseconds (with exponential backoff)
AI_RETRY_DELAY=1000

# ===== CONFIDENCE SCORE THRESHOLDS (0-100) =====
AI_CONFIDENCE_AUTO_POSTED=95
AI_CONFIDENCE_HUMAN_REVIEW=80

# ===== AMOUNT THRESHOLDS (VND) =====
AI_AMOUNT_AUTO_POSTED_MAX=5000000
AI_AMOUNT_HUMAN_REVIEW_MAX=50000000

# ===== CASHFLOW THRESHOLDS =====
AI_CASHFLOW_LARGE=100000000
AI_CASHFLOW_SHORTAGE_DAYS=30

# ===== INVENTORY THRESHOLDS =====
AI_INVENTORY_LOW_STOCK_DAYS=7
AI_INVENTORY_OVERSTOCK_DAYS=90

# Python AI Service URL (for OCR, self-fix, etc.)
PYTHON_AI_SERVICE_URL=https://robust-dedication-production-6a94.up.railway.app