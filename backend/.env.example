PORT=5000

# ============================================
# HYBRID DATABASE CONFIGURATION
# ============================================
# Production (Railway/Render): Use DATABASE_URL
# DATABASE_URL=postgresql://postgres:password@host:port/railway

# Local Development: Use individual variables below
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ketoan_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=Thay_Doi_Chuoi_Nay_Thanh_Cai_Gi_Do_Rat_Dai_Va_Bao_Mat_123!

# ============================================
# REDIS (Optional - for caching)
# ============================================
# Production: Railway will provide REDIS_URL automatically
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# DATABASE SEEDING
# ============================================
# Set to 'true' to auto-seed database with test data on startup
# WARNING: Only works if users table is empty
SEED_DATABASE=false

# ============================================
# ROOT ADMIN CREDENTIALS (Auto-created on first run if DB is empty)
# ============================================
# Default root admin username (only used when users table is empty)
ADMIN_USERNAME=admin
# Default root admin password (CHANGE THIS in production!)
ADMIN_PASSWORD=Admin@123

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated frontend origins allowed by CORS
# Production: https://ketoanonline.up.railway.app,https://banhang.up.railway.app
# Local: http://localhost:3000
FRONTEND_URL=https://ketoanonline.up.railway.app,https://banhang.up.railway.app

# ============================================
# BACKEND URL CONFIGURATION
# ============================================
# Backend API URL for inter-service communication
BACKEND_URL=https://dazzling-grace-production-03a5.up.railway.app

# ============================================
# CASSO OPEN BANKING (THANH TOÁN ONLINE)
# ============================================
# Authcode / API key from Casso (https://oauth.casso.vn)
CASSO_API_KEY=
# Public base URL of this backend (used to build webhook callback URL)
PUBLIC_APP_URL=https://dazzling-grace-production-03a5.up.railway.app
# Optional override of Casso API base (default https://oauth.casso.vn/v2)
# CASSO_BASE_URL=https://oauth.casso.vn/v2
# Optional override of webhook path (default /api/casso/webhook)
# CASSO_WEBHOOK_PATH=/api/casso/webhook

# ============================================
# AI CONFIGURATION
# ============================================
# Python AI Service URL (for OCR, self-fix, etc.)
PYTHON_AI_SERVICE_URL=https://robust-dedication-production-6a94.up.railway.app

# Confidence score thresholds (0-100)
AI_CONFIDENCE_AUTO_POSTED=95
AI_CONFIDENCE_HUMAN_REVIEW=80

# Amount thresholds in VND
AI_AMOUNT_AUTO_POSTED_MAX=5000000
AI_AMOUNT_HUMAN_REVIEW_MAX=50000000

# Cashflow thresholds
AI_CASHFLOW_LARGE=100000000
AI_CASHFLOW_SHORTAGE_DAYS=30

# Inventory thresholds
AI_INVENTORY_LOW_STOCK_DAYS=7
AI_INVENTORY_OVERSTOCK_DAYS=90