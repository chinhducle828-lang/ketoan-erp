{
  "name": "ketoan-erp-backend",
  "version": "1.0.0",
  "description": "Backend hạch toán kế toán kép TT200 và Thông tư 99/2025/TT-BTC",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Backend API-only deployment: Skipping frontend build'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:core": "node test-erp-core.js",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --runInBand",
    "test:stats": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/statistical --verbose",
    "test:perf": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/performance --verbose",
    "test:property": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/property --verbose",
    "test:combinatorial": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/combinatorial --verbose",
    "test:graph": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/graph --verbose",
    "test:queueing": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/queueing --verbose",
    "test:stochastic": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/stochastic --verbose",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:mutation": "stryker run",
    "perf:update-baseline": "node scripts/perf-regression.mjs --update",
    "perf:check": "node scripts/perf-regression.mjs"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.18.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-slow-down": "^3.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
